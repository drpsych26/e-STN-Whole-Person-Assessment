{
  "openapi": "3.1.0",
  "info": {
    "title": "STN API",
    "description": "Non-live integration API. Clinician sign-in via OIDC, server-side roles (clinician, reviewer, admin), MFA enforcement and organisation scoping; encrypted, owner-scoped client and assessment records with key rotation; human review and sign-off workflow; consent records, legal holds and two-person disposal; logged exports; rate limiting; hash-chained audit. No diagnosis, scoring, risk disposition or crisis automation is exposed.",
    "version": "0.3.0"
  },
