  "stn_statement": "STN is not an emergency service. Messages and forms in this app are not monitored around the clock, and sending one does not contact emergency services or a crisis team.",
  "tiers": [
    {
      "id": "immediate_danger",
      "order": 1,
      "heading": "Immediate danger",
      "when": "Someone's life is at risk now, or they cannot be kept safe.",
      "actions": [
        {
          "label": "Call 111",
          "phone": "111",
          "tel": "111",
          "hours": "24/7",
          "detail": "Police, fire and ambulance. Or go to your nearest hospital emergency department."
        }
      ]
    },
    {
      "id": "urgent_crisis",
      "order": 2,
      "heading": "Urgent mental-health crisis",
      "when": "You need urgent mental-health help today but no one is in immediate danger.",
      "actions": [
        {
          "label": "Your local mental-health crisis team",
          "regional": true,
          "hours": "Varies by region",
          "detail": "Choose your region to see the number. If you are unsure, call 111."
        }
      ]
    },
    {
      "id": "distress",
      "order": 3,
      "heading": "Distress: talk to someone now",
      "when": "You are struggling and want to talk to a trained person.",
      "actions": [
        {
          "label": "1737 Need to talk?",
          "phone": "1737",
          "tel": "1737",
          "hours": "24/7",
          "detail": "Free call or text a trained counsellor."
        },
        {
          "label": "Samaritans",
          "phone": "0800 726 666",
          "tel": "0800726666",
          "hours": "24/7",
          "detail": "If you are lonely or in distress."
        },
        {
          "label": "Suicide Crisis Helpline",
          "phone": "0508 828 865",
          "tel": "0508828865",
          "hours": "7am to midnight",
          "detail": "If you are thinking about suicide, or worried about someone. Not 24/7: overnight, call 1737 or 111."
        },
        {
          "label": "Lifeline",
          "phone": "0800 543 354",
          "tel": "0800543354",
          "sms": "4357",
          "hours": "7am to midnight",
          "detail": "Free call, or text 4357. Not 24/7."
        }
      ]
    },
    {
      "id": "routine_support",
      "order": 4,
      "heading": "Routine support",
      "when": "Questions about your appointments, your account or non-urgent support.",
      "actions": [
        {
          "label": "Healthline",
          "phone": "0800 611 116",
          "tel": "0800611116",
          "hours": "24/7",
          "detail": "Free health advice from health professionals."
        },
        {
          "label": "Contact STN",
          "hours": "Business hours (to be confirmed)",
          "detail": "Use the contact details on the STN website. STN does not respond to messages around the clock."
        }
      ]
    }
  ],
