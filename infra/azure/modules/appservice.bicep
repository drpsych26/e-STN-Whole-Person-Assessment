// App Service for Linux running the STN API container (per docs/infrastructure), with:
// - the production slot serving the API as the 'api' identity (data privileges only);
// - a 'migrate' slot running the same image as the 'migrate' identity, used only by the deploy
//   workflow to apply migrations before the API image changes. It serves /healthz and /readyz
//   only and is stopped after each deployment. The slots are never swapped.
// HTTPS only, TLS 1.2+, FTP and basic publishing credentials off, VNet integration with all
// outbound traffic (database, Key Vault, Redis, registry pulls) routed through the VNet.
param location string
param tags object
param planName string
param appName string
param skuName string
param instanceCount int
param zoneRedundant bool
param appSubnetId string
param workspaceId string
param registryLoginServer string
param apiImageTag string
param migrateImageTag string
param apiIdentityId string
param apiIdentityClientId string
param migrateIdentityId string
param migrateIdentityClientId string
@description('API app settings. No secrets: Key Vault references and password-less database URLs only.')
param apiSettings object
@description('Migrate-slot app settings. No secrets.')
param migrateSettings object
@description('Optional inbound allow-list for the API (CIDR strings). Empty: public HTTPS ingress.')
param allowedInboundCidrs array

var restrictions = [for (cidr, i) in allowedInboundCidrs: {
  name: 'allow-${i}'
  ipAddress: cidr
  action: 'Allow'
  priority: 100 + i
}]

var apiAppSettings = [for item in items(apiSettings): { name: item.key, value: item.value }]
var migrateAppSettings = [for item in items(migrateSettings): { name: item.key, value: item.value }]

var commonSiteConfig = {
  alwaysOn: true
  http20Enabled: true
  minTlsVersion: '1.2'
  scmMinTlsVersion: '1.2'
  ftpsState: 'Disabled'
  healthCheckPath: '/healthz'
  acrUseManagedIdentityCreds: true
  ipSecurityRestrictions: restrictions
  ipSecurityRestrictionsDefaultAction: empty(allowedInboundCidrs) ? 'Allow' : 'Deny'
  scmIpSecurityRestrictionsUseMain: true
}

resource plan 'Microsoft.Web/serverfarms@2024-04-01' = {
  name: planName
  location: location
  tags: tags
  kind: 'linux'
  sku: { name: skuName, capacity: instanceCount }
  properties: {
    reserved: true
    zoneRedundant: zoneRedundant
  }
}

resource app 'Microsoft.Web/sites@2024-04-01' = {
  name: appName
  location: location
  tags: tags
  kind: 'app,linux,container'
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: { '${apiIdentityId}': {} }
  }
  properties: {
    serverFarmId: plan.id
    httpsOnly: true
    clientAffinityEnabled: false
    publicNetworkAccess: 'Enabled'
    autoGeneratedDomainNameLabelScope: 'TenantReuse'
    virtualNetworkSubnetId: appSubnetId
    vnetRouteAllEnabled: true
    vnetImagePullEnabled: true
    keyVaultReferenceIdentity: apiIdentityId
    siteConfig: union(commonSiteConfig, {
      linuxFxVersion: 'DOCKER|${registryLoginServer}/stn-api:${apiImageTag}'
      acrUserManagedIdentityID: apiIdentityClientId
      appSettings: apiAppSettings
    })
  }
}

resource migrateSlot 'Microsoft.Web/sites/slots@2024-04-01' = {
  parent: app
  name: 'migrate'
  location: location
  tags: tags
  kind: 'app,linux,container'
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: { '${migrateIdentityId}': {} }
  }
  properties: {
    serverFarmId: plan.id
    httpsOnly: true
    clientAffinityEnabled: false
    publicNetworkAccess: 'Enabled'
    virtualNetworkSubnetId: appSubnetId
    vnetRouteAllEnabled: true
    vnetImagePullEnabled: true
    siteConfig: union(commonSiteConfig, {
      linuxFxVersion: 'DOCKER|${registryLoginServer}/stn-api:${migrateImageTag}'
      acrUserManagedIdentityID: migrateIdentityClientId
      appSettings: migrateAppSettings
    })
  }
}

resource ftpOff 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2024-04-01' = {
  parent: app
  name: 'ftp'
  properties: { allow: false }
}

resource scmOff 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2024-04-01' = {
  parent: app
  name: 'scm'
  properties: { allow: false }
}

resource slotFtpOff 'Microsoft.Web/sites/slots/basicPublishingCredentialsPolicies@2024-04-01' = {
  parent: migrateSlot
  name: 'ftp'
  properties: { allow: false }
}

resource slotScmOff 'Microsoft.Web/sites/slots/basicPublishingCredentialsPolicies@2024-04-01' = {
  parent: migrateSlot
  name: 'scm'
  properties: { allow: false }
}

var siteLogs = [ 'AppServiceHTTPLogs', 'AppServiceConsoleLogs', 'AppServiceAppLogs', 'AppServicePlatformLogs' ]

resource appDiagnostics 'Microsoft.Insights/diagnosticSettings@2021-05-01-preview' = {
  scope: app
  name: 'to-log-analytics'
  properties: {
    workspaceId: workspaceId
    logs: [for category in siteLogs: { category: category, enabled: true }]
    metrics: [ { category: 'AllMetrics', enabled: true } ]
  }
}

resource slotDiagnostics 'Microsoft.Insights/diagnosticSettings@2021-05-01-preview' = {
  scope: migrateSlot
  name: 'to-log-analytics'
  properties: {
    workspaceId: workspaceId
    logs: [for category in siteLogs: { category: category, enabled: true }]
    metrics: [ { category: 'AllMetrics', enabled: true } ]
  }
}

output appName string = app.name
output defaultHostName string = app.properties.defaultHostName
